{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "22.14.0",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.14.0",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.orynoafrica.com",
        "EXPO_PUBLIC_API_PREFIX": "/api/external/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "22.14.0",
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.orynoafrica.com",
        "EXPO_PUBLIC_API_PREFIX": "/api/external/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
